[Unit]
Description=Open source interface for iCUE LINK System Hub, Corsair AIOs and Hubs
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Keep the immutable image payload in /usr/lib, but run from a writable
# per-user copy because OpenLinkHub persists config and device profiles.
WorkingDirectory=%h/.local/share/OpenLinkHub
ExecStartPre=/usr/bin/install -d %h/.local/share/OpenLinkHub
ExecStartPre=/usr/bin/cp --archive --update=none /usr/lib/OpenLinkHub/. %h/.local/share/OpenLinkHub/
ExecStart=/usr/bin/bash -c 'exec "$HOME/.local/share/OpenLinkHub/OpenLinkHub"'
ExecReload=/bin/kill -s HUP $MAINPID
RestartSec=5
Restart=always

[Install]
WantedBy=default.target

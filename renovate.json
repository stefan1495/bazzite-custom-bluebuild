{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^recipes/common-modules\\.yml$/"
      ],
      "matchStrings": [
        "https://github\\.com/timmo001/system-bridge/releases/download/(?<currentValue>.*?)/system-bridge-.*\\.rpm"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timmo001/system-bridge"
    }
  ]
}

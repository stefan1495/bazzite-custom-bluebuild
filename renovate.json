{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customDatasources": {
    "proton-pass": {
      "defaultRegistryUrlTemplate": "https://proton.me/download/PassDesktop/linux/x64/version.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map($filter($map($filter(Releases, function($r){$r.CategoryName=\"Stable\"}), function($r){$filter($r.File, function($f){$match($f.Url, /^https:\\/\\/proton\\.me\\/download\\/pass\\/linux\\/proton-pass-[0-9]+(?:\\.[0-9]+){2}-[0-9]+\\.x86_64\\.rpm$/)})[0].Url}), function($u){$exists($u)}), function($u){($version := $replace($u, /^https:\\/\\/proton\\.me\\/download\\/pass\\/linux\\/proton-pass-(.*)\\.rpm$/, \"$1\"); $tagVersion := $replace($version, /^([0-9]+(?:\\.[0-9]+){2})-[0-9]+\\.x86_64$/, \"$1\"); {\"version\": $version, \"sourceUrl\": \"https://github.com/ProtonMail/WebClients\", \"sourceDirectory\": \"applications/pass\", \"changelogUrl\": $join([\"https://github.com/ProtonMail/WebClients/blob/proton-pass%40\", $tagVersion, \"/applications/pass/CHANGELOG.md\"])})}), \"sourceUrl\": \"https://github.com/ProtonMail/WebClients\", \"sourceDirectory\": \"applications/pass\", \"changelogUrl\": \"https://github.com/ProtonMail/WebClients/blob/main/applications/pass/CHANGELOG.md\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^recipes/common-modules\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\n\\s*-\\s*https://proton\\.me/download/pass/linux/proton-pass-(?<currentValue>[0-9]+(?:\\.[0-9]+){2}-[0-9]+\\.x86_64)\\.rpm"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^recipes/common-modules\\.yml$/"
      ],
      "matchStrings": [
        "https://github\\.com/timmo001/system-bridge/releases/download/(?<currentValue>.*?)/system-bridge-.*\\.rpm"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timmo001/system-bridge"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^recipes/common-modules\\.yml$/"
      ],
      "matchStrings": [
        "https://github\\.com/music-assistant/desktop-app/releases/download/(?<currentValue>.*?)/Music\\.Assistant-.*\\.x86_64\\.rpm"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "music-assistant/desktop-app"
    }
  ]
}

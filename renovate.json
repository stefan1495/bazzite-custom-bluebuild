{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customDatasources": {
    "proton-pass": {
      "defaultRegistryUrlTemplate": "https://proton.me/download/PassDesktop/linux/x64/version.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map($filter($map($filter(Releases, function($r){$r.CategoryName=\"Stable\"}), function($r){$filter($r.File, function($f){$match($f.Url, /^https:\\/\\/proton\\.me\\/download\\/pass\\/linux\\/proton-pass-[0-9]+(?:\\.[0-9]+){2}-[0-9]+\\.x86_64\\.rpm$/)})[0].Url}), function($u){$exists($u)}), function($u){($version := $replace($u, /^https:\\/\\/proton\\.me\\/download\\/pass\\/linux\\/proton-pass-(.*)\\.rpm$/, \"$1\"); $tagVersion := $replace($version, /^([0-9]+(?:\\.[0-9]+){2})-[0-9]+\\.x86_64$/, \"$1\"); {\"version\": $version, \"sourceUrl\": \"https://github.com/ProtonMail/WebClients\", \"sourceDirectory\": \"applications/pass\", \"changelogUrl\": $join([\"https://github.com/ProtonMail/WebClients/blob/proton-pass%40\", $tagVersion, \"/applications/pass/CHANGELOG.md\"])})}), \"sourceUrl\": \"https://github.com/ProtonMail/WebClients\", \"sourceDirectory\": \"applications/pass\", \"changelogUrl\": \"https://github.com/ProtonMail/WebClients/blob/main/applications/pass/CHANGELOG.md\"}"
      ]
    },
    "discord": {
      "defaultRegistryUrlTemplate": "https://discord.com/api/download?platform=linux&format=json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $replace($exists(url) ? url : $exists(download_url) ? download_url : $string($), /.*discord-([0-9]+(?:\\.[0-9]+){2})\\.rpm$/, \"$1\")}]} "
      ]
    },
    "system-bridge-tags": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/timmo001/system-bridge/tags?per_page=100",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map($, function($tag){({\"version\": $tag.name, \"digest\": $tag.commit.sha})})}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build_files/scripts/30-install-packages\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\nPROTON_PASS_URL=\\\"https://proton\\.me/download/pass/linux/proton-pass-(?<currentValue>[0-9]+(?:\\.[0-9]+){2}-[0-9]+\\.x86_64)\\.rpm\\\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "ARG SYSTEM_BRIDGE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "custom.system-bridge-tags",
      "depNameTemplate": "timmo001/system-bridge",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build_files/helpers/build-system-bridge-source\\.sh$/"
      ],
      "matchStrings": [
        "source_pin=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "custom.system-bridge-tags",
      "depNameTemplate": "timmo001/system-bridge",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "source_pin={{{newValue}}}@{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build_files/scripts/30-install-packages\\.sh$/"
      ],
      "matchStrings": [
        "https://github\\.com/stablyai/orca/releases/download/.*?/orca-ide-(?<currentValue>[0-9]+(?:\\.[0-9]+){2})\\.x86_64\\.rpm"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "stablyai/orca"
    }
  ]
}
